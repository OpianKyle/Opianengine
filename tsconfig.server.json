{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "outDir": "dist/server",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["client/src/*"],
      "@db/*": ["db/*"],
      "@db": ["db"]
    }
  },
  "include": ["server/**/*.ts", "db/**/*.ts"],
  "exclude": ["node_modules", "client"]
}