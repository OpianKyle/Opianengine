{"success":false,"message":"Failed to generate PDF: html-pdf: Unknown Error\nCan't open '\n        function() {\n          function setBackgroundColor() {\n            / Set styles for HTML and BODY elements\n            document.documentElement.style.backgroundColor = '#011d3d';\n            document.documentElement.style.background = '#011d3d';\n            document.body.style.backgroundColor = '#011d3d';\n            document.body.style.background = '#011d3d';\n            document.body.bgColor = '#011d3d';\n            \n            / Force all elements to have transparent background or #011d3d\n            var allElements = document.querySelectorAll('*');\n            for (var i = 0; i < allElements.length; i++) {\n              var el = allElements[i];\n              if (el.tagName !== 'DIV' && el.tagName !== 'HTML' && el.tagName !== 'BODY') continue;\n              \n              var bg = window.getComputedStyle(el).backgroundColor;\n              if (bg === 'rgba(0, 0, 0, 0)' || bg === 'transparent') {\n                el.style.backgroundColor = '#011d3d';\n              }\n            }\n            \n            / Create multiple background divs with different z-indices\n            var bgDiv1 = document.createElement('div');\n            bgDiv1.style.position = 'fixed';\n            bgDiv1.style.top = '0';\n            bgDiv1.style.left = '0';\n            bgDiv1.style.width = '100%';\n            bgDiv1.style.height = '100%';\n            bgDiv1.style.backgroundColor = '#011d3d';\n            bgDiv1.style.zIndex = '-1000';\n            document.body.insertBefore(bgDiv1, document.body.firstChild);\n            \n            / Create another full-page background div as a fallback\n            var bgDiv2 = document.createElement('div');\n            bgDiv2.style.position = 'fixed';\n            bgDiv2.style.top = '0';\n            bgDiv2.style.left = '0';\n            bgDiv2.style.right = '0';\n            bgDiv2.style.bottom = '0';\n            bgDiv2.style.backgroundColor = '#011d3d';\n            bgDiv2.style.zIndex = '-999';\n            document.body.appendChild(bgDiv2);\n            \n            / Create a canvas background as another fallback approach\n            var canvas = document.createElement('canvas');\n            canvas.width = window.innerWidth;\n            canvas.height = window.innerHeight;\n            canvas.style.position = 'fixed';\n            canvas.style.top = '0';\n            canvas.style.left = '0';\n            canvas.style.zIndex = '-998';\n            var ctx = canvas.getContext('2d');\n            ctx.fillStyle = '#011d3d';\n            ctx.fillRect(0, 0, canvas.width, canvas.height);\n            document.body.appendChild(canvas);\n          }\n          \n          / Run once immediately\n          setBackgroundColor();\n          \n          / Run again after a delay to ensure styles are applied\n          setTimeout(setBackgroundColor, 300);\n          \n          / Return true to indicate the script executed successfully\n          return true;\n        }\n      '\n"}